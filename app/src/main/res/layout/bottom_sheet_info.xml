<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_bg">

    <!-- Tutamaç -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="@drawable/sheet_handle"
        android:layout_gravity="center"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"/>

    <!-- Başlık -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Bölgeye Özel Öneriler"
        android:textSize="20sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:layout_marginBottom="4dp"/>

    <!-- Teşhis bilgisi -->
    <TextView
        android:id="@+id/tvUrgency"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="13sp"
        android:textColor="#C9A84C"
        android:textStyle="bold"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:layout_marginBottom="16dp"/>

    <!-- Bölge seçimi -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vücut Bölgesini Seçin"
            android:textSize="12sp"
            android:textColor="#7B7B9A"
            android:layout_marginBottom="8dp"/>

        <Spinner
            android:id="@+id/spinnerRegion"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/spinner_bg"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"/>
    </LinearLayout>

    <!-- Öneri getir butonu -->
    <Button
        android:id="@+id/btnGetInfo"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Önerileri Getir →"
        android:textColor="#1A1035"
        android:textStyle="bold"
        android:backgroundTint="#C9A84C"
        app:cornerRadius="12dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="16dp"/>

    <!-- Bilgi kartları scroll -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="340dp"
        android:scrollbars="none"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/infoContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>
    </ScrollView>

    <!-- Harita butonları -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <Button
            android:id="@+id/btnDerma"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="🔍 Dermatolog Bul"
            android:textColor="#1A1035"
            android:textSize="12sp"
            android:textStyle="bold"
            android:backgroundTint="#C9A84C"
            app:cornerRadius="12dp"/>

        <Button
            android:id="@+id/btnHospital"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="🏥 Hastane Bul"
            android:textColor="#C9A84C"
            android:textSize="12sp"
            android:backgroundTint="#22224A"
            app:cornerRadius="12dp"/>
    </LinearLayout>

</LinearLayout>