<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF7F2">

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <!-- Üst bar -->
            <LinearLayout
                android:id="@+id/headerLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="48dp"
                android:layout_marginBottom="20dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tvGreeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Merhaba"
                        android:textSize="26sp"
                        android:textColor="#2C2318"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cilt sagligini takip et"
                        android:textSize="13sp"
                        android:textColor="#B5A898"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
                <TextView
                    android:id="@+id/tvProfileAvatar"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:text="😊"
                    android:textSize="22sp"
                    android:gravity="center"
                    android:background="@drawable/circle_orange_light"/>
            </LinearLayout>

            <!-- UV Kart -->
            <androidx.cardview.widget.CardView
                android:id="@+id/uvCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                android:alpha="0"
                android:layout_marginBottom="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">
                    <TextView
                        android:id="@+id/tvUVIcon"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:text="☀️"
                        android:textSize="22sp"
                        android:gravity="center"
                        android:background="@drawable/circle_orange_light"/>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">
                        <TextView
                            android:id="@+id/tvUVIndex"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="UV Indeksi yukleniyor..."
                            android:textSize="14sp"
                            android:textColor="#2C2318"
                            android:textStyle="bold"/>
                        <TextView
                            android:id="@+id/tvUVMessage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Konum aliniyor..."
                            android:textSize="12sp"
                            android:textColor="#B5A898"
                            android:layout_marginTop="3dp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Tarama kartı -->
            <androidx.cardview.widget.CardView
                android:id="@+id/scanCard"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#D17F52"
                android:layout_marginBottom="24dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="24dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Yeni Tarama"
                        android:textSize="20sp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lezyonunu fotoğrafla, yapay zeka analiz etsin"
                        android:textSize="13sp"
                        android:textColor="#FFF5E6"
                        android:layout_weight="1"/>
                    <Button
                        android:id="@+id/btnScan"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:text="Başlat"
                        android:textColor="#8F4520"
                        android:textStyle="bold"
                        android:backgroundTint="#FFFFFF"
                        android:paddingStart="24dp"
                        android:paddingEnd="24dp"
                        app:cornerRadius="22dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Son taramalar baslik -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="SON TARAMALARIM"
                    android:textSize="11sp"
                    android:textColor="#B5A898"
                    android:letterSpacing="0.15"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="12sp"
                    android:textColor="#E8823A"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvNoScans"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Henüz tarama yapılmadı."
                android:textSize="13sp"
                android:textColor="#B5A898"
                android:gravity="center"
                android:visibility="gone"
                android:padding="20dp"/>

            <LinearLayout
                android:id="@+id/scansList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp"/>

            <!-- Risk açıklamaları -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NASIL YORUMLANIR?"
                android:textSize="11sp"
                android:textColor="#B5A898"
                android:letterSpacing="0.15"
                android:layout_marginBottom="12dp"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="8dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">
                    <TextView android:layout_width="36dp" android:layout_height="36dp"
                        android:text="✅" android:textSize="18sp" android:gravity="center"
                        android:background="@drawable/circle_green_light"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="14dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Düşük Risk" android:textColor="#2E7D32"
                            android:textStyle="bold" android:textSize="14sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Lezyon buyuk olasilikla iyi huylu. 6-12 ayda bir dermatologa gorunmek onerilir."
                            android:textColor="#B5A898" android:textSize="12sp" android:layout_marginTop="3dp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="8dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">
                    <TextView android:layout_width="36dp" android:layout_height="36dp"
                        android:text="⚠️" android:textSize="18sp" android:gravity="center"
                        android:background="@drawable/circle_orange_light"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="14dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Orta Risk" android:textColor="#E65100"
                            android:textStyle="bold" android:textSize="14sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Takip gerektiriyor. 1-3 ay içinde bir dermatologa başvurman önerilir."
                            android:textColor="#B5A898" android:textSize="12sp" android:layout_marginTop="3dp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="8dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">
                    <TextView android:layout_width="36dp" android:layout_height="36dp"
                        android:text="🔴" android:textSize="18sp" android:gravity="center"
                        android:background="@drawable/circle_red_light"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="14dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Yüksek Risk" android:textColor="#C62828"
                            android:textStyle="bold" android:textSize="14sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Acil dermatoloji muayenesi önerilir. Bu uygulama tıbbı teşhis yerine geçmez."
                            android:textColor="#B5A898" android:textSize="12sp" android:layout_marginTop="3dp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFF3E0"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Bu uygulama yapay zeka destekli bir tarama aracıdır. Sonuçlar kesin tıbbi teşhis niteliğini taşımıyor."
                    android:textSize="12sp"
                    android:textColor="#7A6E65"
                    android:padding="16dp"
                    android:lineSpacingExtra="3dp"/>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        app:itemIconTint="#292524"
        app:itemTextColor="#292524"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>