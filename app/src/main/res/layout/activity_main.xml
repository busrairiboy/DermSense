<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_bg">

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <!-- Üst bar -->
            <LinearLayout
                android:id="@+id/headerLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="48dp"
                android:layout_marginBottom="20dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tvGreeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Merhaba 👋"
                        android:textSize="26sp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cilt sağlığını takip et"
                        android:textSize="13sp"
                        android:textColor="#7B7B9A"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
                <TextView
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:text="👤"
                    android:textSize="20sp"
                    android:gravity="center"
                    android:background="@drawable/circle_dark"/>
            </LinearLayout>

            <!-- UV İndeksi Kartı -->
            <androidx.cardview.widget.CardView
                android:id="@+id/uvCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#1A1A32"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                android:alpha="0"
                android:layout_marginBottom="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvUVIcon"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:text="☀️"
                        android:textSize="22sp"
                        android:gravity="center"
                        android:background="@drawable/circle_dark"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">

                        <TextView
                            android:id="@+id/tvUVIndex"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="UV İndeksi yükleniyor..."
                            android:textSize="14sp"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/tvUVMessage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Konum alınıyor..."
                            android:textSize="12sp"
                            android:textColor="#7B7B9A"
                            android:layout_marginTop="3dp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Tarama kartı -->
            <androidx.cardview.widget.CardView
                android:id="@+id/scanCard"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="12dp"
                app:cardBackgroundColor="#00000000"
                android:layout_marginBottom="24dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:background="@drawable/scan_card_gradient"
                    android:padding="24dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Yeni Tarama"
                        android:textSize="20sp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lezyonunu fotoğrafla, yapay zeka analiz etsin"
                        android:textSize="13sp"
                        android:textColor="#CCCCDD"
                        android:layout_weight="1"/>
                    <Button
                        android:id="@+id/btnScan"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:text="Başlat →"
                        android:textColor="#1A1035"
                        android:textStyle="bold"
                        android:backgroundTint="#C9A84C"
                        android:paddingStart="24dp"
                        android:paddingEnd="24dp"
                        app:cornerRadius="22dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Son taramalar başlık -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="SON TARAMALARIM"
                    android:textSize="11sp"
                    android:textColor="#7B7B9A"
                    android:letterSpacing="0.15"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tümü →"
                    android:textSize="12sp"
                    android:textColor="#C9A84C"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvNoScans"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Henüz tarama yapılmadı.\nİlk taramanı başlatmak için yukarıdaki butona bas."
                android:textSize="13sp"
                android:textColor="#7B7B9A"
                android:gravity="center"
                android:visibility="gone"
                android:padding="20dp"/>

            <LinearLayout
                android:id="@+id/scansList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp"/>

            <!-- Bilgilendirme -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NASIL YORUMLANIR?"
                android:textSize="11sp"
                android:textColor="#7B7B9A"
                android:letterSpacing="0.15"
                android:layout_marginBottom="12dp"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#1A1A32"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="8dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">
                    <TextView android:layout_width="36dp" android:layout_height="36dp"
                        android:text="✅" android:textSize="18sp" android:gravity="center"
                        android:background="@drawable/circle_dark"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="14dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Düşük Risk" android:textColor="#44BB44"
                            android:textStyle="bold" android:textSize="14sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Lezyon büyük olasılıkla iyi huylu. 6-12 ayda bir dermatologa görünmek önerilir."
                            android:textColor="#7B7B9A" android:textSize="12sp" android:layout_marginTop="3dp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#1A1A32"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="8dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">
                    <TextView android:layout_width="36dp" android:layout_height="36dp"
                        android:text="⚠️" android:textSize="18sp" android:gravity="center"
                        android:background="@drawable/circle_dark"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="14dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Orta Risk" android:textColor="#FFA500"
                            android:textStyle="bold" android:textSize="14sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Takip gerektiriyor. 1-3 ay içinde bir dermatologa başvurman önerilir."
                            android:textColor="#7B7B9A" android:textSize="12sp" android:layout_marginTop="3dp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#1A1A32"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="8dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">
                    <TextView android:layout_width="36dp" android:layout_height="36dp"
                        android:text="🔴" android:textSize="18sp" android:gravity="center"
                        android:background="@drawable/circle_dark"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="14dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Yüksek Risk" android:textColor="#FF4444"
                            android:textStyle="bold" android:textSize="14sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Acil dermatoloji muayenesi önerilir. Bu uygulama tıbbi teşhis yerine geçmez."
                            android:textColor="#7B7B9A" android:textSize="12sp" android:layout_marginTop="3dp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#1A1225"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ℹ️  Bu uygulama yapay zeka destekli bir tarama aracıdır. Sonuçlar kesin tıbbi teşhis niteliği taşımaz."
                    android:textSize="12sp"
                    android:textColor="#7B7B9A"
                    android:padding="16dp"
                    android:lineSpacingExtra="3dp"/>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#15152E"
        app:itemIconTint="#C9A84C"
        app:itemTextColor="#C9A84C"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>