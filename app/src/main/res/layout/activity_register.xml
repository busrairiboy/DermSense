<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF7F2">

    <View
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_gravity="top|end"
        android:translationX="90dp"
        android:translationY="-90dp"
        android:background="@drawable/deco_circle_top"/>

    <View
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_gravity="bottom|start"
        android:translationX="-70dp"
        android:translationY="70dp"
        android:background="@drawable/deco_circle_bottom"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#00000000"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp">

            <!-- Logo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="52dp"
                android:layout_marginBottom="28dp">

                <FrameLayout
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="16dp">

                    <View
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        android:background="@drawable/logo_ring_outer"/>

                    <View
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_gravity="center"
                        android:background="@drawable/logo_ring_inner"/>

                    <ImageView
                        android:id="@+id/ivLogo"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_gravity="center"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_logo"/>
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DermSense"
                    android:textSize="28sp"
                    android:textColor="#2C2318"
                    android:textStyle="bold"
                    android:layout_gravity="center"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hesap olustur"
                    android:textSize="13sp"
                    android:textColor="#B5A898"
                    android:layout_gravity="center"/>
            </LinearLayout>

            <!-- Tab satiri -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:background="@drawable/tab_bg_light"
                android:padding="4dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:id="@+id/tabLogin"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Giris Yap"
                    android:textSize="14sp"
                    android:textColor="#7A6E65"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Kayit Ol"
                    android:textSize="14sp"
                    android:textColor="#F5A623"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="@drawable/tab_active_light"/>
            </LinearLayout>

            <!-- Ad - Soyad yan yana -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Ad" android:textSize="12sp" android:textColor="#B5A898"
                        android:layout_marginBottom="6dp"/>
                    <EditText android:id="@+id/etFirstName"
                        android:layout_width="match_parent" android:layout_height="52dp"
                        android:textColor="#2C2318" android:textColorHint="#C8BDB1"
                        android:inputType="textPersonName"
                        android:background="@drawable/input_bg_light"
                        android:paddingStart="14dp" android:paddingEnd="14dp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Soyad" android:textSize="12sp" android:textColor="#B5A898"
                        android:layout_marginBottom="6dp"/>
                    <EditText android:id="@+id/etLastName"
                        android:layout_width="match_parent" android:layout_height="52dp"
                        android:textColor="#2C2318" android:textColorHint="#C8BDB1"
                        android:inputType="textPersonName"
                        android:background="@drawable/input_bg_light"
                        android:paddingStart="14dp" android:paddingEnd="14dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- E-posta -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="E-posta" android:textSize="12sp" android:textColor="#B5A898"
                android:layout_marginBottom="6dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="52dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:background="@drawable/input_bg_light"
                android:paddingStart="14dp" android:paddingEnd="14dp" android:layout_marginBottom="12dp">
                <TextView android:layout_width="20dp" android:layout_height="wrap_content"
                    android:text="✉" android:textSize="14sp" android:textColor="#C8BDB1"
                    android:gravity="center" android:layout_marginEnd="10dp"/>
                <EditText android:id="@+id/etEmail"
                    android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                    android:textColor="#2C2318" android:textColorHint="#C8BDB1"
                    android:inputType="textEmailAddress" android:background="@null" android:padding="0dp"/>
            </LinearLayout>

            <!-- Sifre -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Sifre" android:textSize="12sp" android:textColor="#B5A898"
                android:layout_marginBottom="6dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="52dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:background="@drawable/input_bg_light"
                android:paddingStart="14dp" android:paddingEnd="14dp" android:layout_marginBottom="6dp">
                <TextView android:layout_width="20dp" android:layout_height="wrap_content"
                    android:text="🔒" android:textSize="14sp" android:textColor="#C8BDB1"
                    android:gravity="center" android:layout_marginEnd="10dp"/>
                <EditText android:id="@+id/etPassword"
                    android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                    android:textColor="#2C2318" android:textColorHint="#C8BDB1"
                    android:inputType="textPassword" android:background="@null" android:padding="0dp"/>
            </LinearLayout>

            <!-- Sifre guc barlari -->
            <LinearLayout android:id="@+id/strengthBars"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="8dp">
                <View android:id="@+id/bar1" android:layout_width="0dp" android:layout_height="4dp"
                    android:layout_weight="1" android:background="#E8E0D5" android:layout_marginEnd="3dp"/>
                <View android:id="@+id/bar2" android:layout_width="0dp" android:layout_height="4dp"
                    android:layout_weight="1" android:background="#E8E0D5" android:layout_marginEnd="3dp"/>
                <View android:id="@+id/bar3" android:layout_width="0dp" android:layout_height="4dp"
                    android:layout_weight="1" android:background="#E8E0D5" android:layout_marginEnd="3dp"/>
                <View android:id="@+id/bar4" android:layout_width="0dp" android:layout_height="4dp"
                    android:layout_weight="1" android:background="#E8E0D5"/>
            </LinearLayout>

            <!-- Kriterler -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginBottom="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="4dp">
                    <TextView android:id="@+id/criteriaLength" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="● "
                        android:textSize="11sp" android:textColor="#C8BDB1"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="En az 6 karakter" android:textSize="11sp" android:textColor="#B5A898"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="4dp">
                    <TextView android:id="@+id/criteriaUpper" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="● "
                        android:textSize="11sp" android:textColor="#C8BDB1"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Buyuk harf" android:textSize="11sp" android:textColor="#B5A898"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="4dp">
                    <TextView android:id="@+id/criteriaNumber" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="● "
                        android:textSize="11sp" android:textColor="#C8BDB1"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Rakam" android:textSize="11sp" android:textColor="#B5A898"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView android:id="@+id/criteriaSpecial" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="● "
                        android:textSize="11sp" android:textColor="#C8BDB1"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Ozel karakter (!@#$...)" android:textSize="11sp" android:textColor="#B5A898"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Yas -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Yas" android:textSize="12sp" android:textColor="#B5A898"
                android:layout_marginBottom="6dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="52dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:background="@drawable/input_bg_light"
                android:paddingStart="14dp" android:paddingEnd="14dp" android:layout_marginBottom="16dp">
                <TextView android:layout_width="20dp" android:layout_height="wrap_content"
                    android:text="🎂" android:textSize="14sp" android:textColor="#C8BDB1"
                    android:gravity="center" android:layout_marginEnd="10dp"/>
                <EditText android:id="@+id/etAge"
                    android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                    android:textColor="#2C2318" android:textColorHint="#C8BDB1"
                    android:inputType="number" android:background="@null" android:padding="0dp"/>
            </LinearLayout>

            <!-- Hata -->
            <TextView android:id="@+id/tvError"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="" android:textColor="#D32F2F" android:textSize="12sp"
                android:visibility="gone" android:background="@drawable/badge_red"
                android:padding="10dp" android:layout_marginBottom="12dp"/>

            <ProgressBar android:id="@+id/progressBar"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center" android:visibility="gone"
                android:layout_marginBottom="12dp" android:indeterminateTint="#F5A623"/>

            <!-- Kayit Ol butonu -->
            <Button android:id="@+id/btnRegister"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:text="Kayit Ol"
                android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="15sp"
                android:backgroundTint="#F5A623" app:cornerRadius="14dp"
                android:layout_marginBottom="20dp"/>

            <!-- Giris yap linki -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Zaten hesabin var mi? "
                    android:textSize="13sp" android:textColor="#7A6E65"/>
                <TextView android:id="@+id/btnLogin"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Giris yap"
                    android:textSize="13sp" android:textColor="#E8823A" android:textStyle="bold"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</FrameLayout>