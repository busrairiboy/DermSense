<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF7F2">

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="40dp">

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Ayarlar" android:textSize="26sp" android:textColor="#2C2318"
                android:textStyle="bold" android:paddingTop="48dp" android:layout_marginBottom="24dp"/>

            <!-- HESAP -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="HESAP BILGILERI" android:textSize="11sp"
                android:textColor="#B5A898" android:letterSpacing="0.15" android:layout_marginBottom="8dp"/>

            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="16dp"
                app:cardElevation="2dp" android:layout_marginBottom="20dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingStart="16dp" android:paddingEnd="16dp">
                        <TextView android:layout_width="32dp" android:layout_height="32dp"
                            android:text="👤" android:textSize="16sp" android:gravity="center"
                            android:background="@drawable/circle_orange_light"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="14dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Ad Soyad" android:textSize="11sp" android:textColor="#B5A898"/>
                            <EditText android:id="@+id/etName"
                                android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:textSize="13sp" android:textColor="#2C2318"
                                android:background="@null" android:padding="0dp"
                                android:inputType="textPersonName"/>
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="›" android:textSize="20sp" android:textColor="#C8BDB1"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#E8E0D5" android:layout_marginStart="62dp"/>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingStart="16dp" android:paddingEnd="16dp">
                        <TextView android:layout_width="32dp" android:layout_height="32dp"
                            android:text="📧" android:textSize="16sp" android:gravity="center"
                            android:background="@drawable/circle_orange_light"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="14dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="E-posta" android:textSize="11sp" android:textColor="#B5A898"/>
                            <EditText android:id="@+id/etEmail"
                                android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:textSize="13sp" android:textColor="#2C2318"
                                android:background="@null" android:padding="0dp"
                                android:inputType="textEmailAddress"
                                android:focusable="false" android:clickable="false"/>
                        </LinearLayout>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#E8E0D5" android:layout_marginStart="62dp"/>

                    <LinearLayout android:id="@+id/rowChangeEmail"
                        android:layout_width="match_parent" android:layout_height="56dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:background="?attr/selectableItemBackground">
                        <TextView android:layout_width="32dp" android:layout_height="32dp"
                            android:text="✉️" android:textSize="16sp" android:gravity="center"
                            android:background="@drawable/circle_orange_light"/>
                        <TextView android:id="@+id/btnChangeEmail"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="E-posta Degistir"
                            android:textSize="13sp" android:textColor="#2C2318"
                            android:layout_marginStart="14dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="›" android:textSize="20sp" android:textColor="#C8BDB1"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#E8E0D5" android:layout_marginStart="62dp"/>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingStart="16dp" android:paddingEnd="16dp">
                        <TextView android:layout_width="32dp" android:layout_height="32dp"
                            android:text="🎂" android:textSize="16sp" android:gravity="center"
                            android:background="@drawable/circle_orange_light"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="14dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Yas" android:textSize="11sp" android:textColor="#B5A898"/>
                            <EditText android:id="@+id/etAge"
                                android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:textSize="13sp" android:textColor="#2C2318"
                                android:background="@null" android:padding="0dp"
                                android:inputType="number"/>
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="›" android:textSize="20sp" android:textColor="#C8BDB1"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#E8E0D5" android:layout_marginStart="62dp"/>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingStart="16dp" android:paddingEnd="16dp">
                        <TextView android:layout_width="32dp" android:layout_height="32dp"
                            android:text="🌡️" android:textSize="16sp" android:gravity="center"
                            android:background="@drawable/circle_orange_light"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="14dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Deri Tipi" android:textSize="11sp" android:textColor="#B5A898"/>
                            <Spinner android:id="@+id/spinnerSkinType"
                                android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:background="@null"/>
                        </LinearLayout>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#E8E0D5" android:layout_marginStart="62dp"/>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingStart="16dp" android:paddingEnd="16dp">
                        <Button android:id="@+id/btnSaveProfile"
                            android:layout_width="0dp" android:layout_height="40dp"
                            android:layout_weight="1" android:layout_marginEnd="8dp"
                            android:text="Kaydet" android:textColor="#FFFFFF" android:textStyle="bold"
                            android:backgroundTint="#C8926A" app:cornerRadius="10dp"/>
                        <Button android:id="@+id/btnChangePassword"
                            android:layout_width="0dp" android:layout_height="40dp"
                            android:layout_weight="1"
                            android:text="Sifre Degistir" android:textColor="#E8823A"
                            android:backgroundTint="#FFF3E0" app:cornerRadius="10dp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- BİLDİRİMLER -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="BILDIRIMLER" android:textSize="11sp"
                android:textColor="#B5A898" android:letterSpacing="0.15" android:layout_marginBottom="8dp"/>

            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="16dp"
                app:cardElevation="2dp" android:layout_marginBottom="20dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:paddingTop="10dp" android:paddingBottom="10dp">
                        <TextView android:layout_width="32dp" android:layout_height="32dp"
                            android:text="⏰" android:textSize="16sp" android:gravity="center"
                            android:background="@drawable/circle_orange_light"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="14dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Tarama Hatirlaticisi" android:textSize="13sp"
                                android:textColor="#2C2318" android:textStyle="bold"/>
                            <Spinner android:id="@+id/spinnerReminder"
                                android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:background="@null" android:layout_marginTop="2dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#E8E0D5" android:layout_marginStart="62dp"/>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingStart="16dp" android:paddingEnd="16dp">
                        <TextView android:layout_width="32dp" android:layout_height="32dp"
                            android:text="☀️" android:textSize="16sp" android:gravity="center"
                            android:background="@drawable/circle_orange_light"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="14dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="UV Uyarisi" android:textSize="13sp"
                                android:textColor="#2C2318" android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="UV yuksekken bildirim al" android:textSize="11sp"
                                android:textColor="#B5A898"/>
                        </LinearLayout>
                        <Switch android:id="@+id/switchUVNotification"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:thumbTint="#F5A623" android:trackTint="#33F5A623"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- GİZLİLİK -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="GIZLILIK VE VERILER" android:textSize="11sp"
                android:textColor="#B5A898" android:letterSpacing="0.15" android:layout_marginBottom="8dp"/>

            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="16dp"
                app:cardElevation="2dp" android:layout_marginBottom="20dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:background="?attr/selectableItemBackground">
                        <TextView android:layout_width="32dp" android:layout_height="32dp"
                            android:text="📤" android:textSize="16sp" android:gravity="center"
                            android:background="@drawable/circle_orange_light"/>
                        <TextView android:id="@+id/btnExportData"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="Taramalari Disa Aktar"
                            android:textSize="13sp" android:textColor="#2C2318"
                            android:layout_marginStart="14dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="›" android:textSize="20sp" android:textColor="#C8BDB1"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#E8E0D5" android:layout_marginStart="62dp"/>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:background="?attr/selectableItemBackground">
                        <TextView android:layout_width="32dp" android:layout_height="32dp"
                            android:text="🔒" android:textSize="16sp" android:gravity="center"
                            android:background="@drawable/circle_orange_light"/>
                        <TextView android:id="@+id/btnPrivacyPolicy"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="Veri Politikasi"
                            android:textSize="13sp" android:textColor="#2C2318"
                            android:layout_marginStart="14dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="›" android:textSize="20sp" android:textColor="#C8BDB1"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#E8E0D5" android:layout_marginStart="62dp"/>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:background="?attr/selectableItemBackground">
                        <TextView android:layout_width="32dp" android:layout_height="32dp"
                            android:text="🗑️" android:textSize="16sp" android:gravity="center"
                            android:background="@drawable/circle_red_light"/>
                        <TextView android:id="@+id/btnDeleteScans"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="Tüm Taramalari Sil"
                            android:textSize="13sp" android:textColor="#C62828"
                            android:layout_marginStart="14dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="›" android:textSize="20sp" android:textColor="#C8BDB1"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#E8E0D5" android:layout_marginStart="62dp"/>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:background="?attr/selectableItemBackground">
                        <TextView android:layout_width="32dp" android:layout_height="32dp"
                            android:text="⛔" android:textSize="16sp" android:gravity="center"
                            android:background="@drawable/circle_red_light"/>
                        <TextView android:id="@+id/btnDeleteAccount"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="Hesabi Sil"
                            android:textSize="13sp" android:textColor="#C62828"
                            android:layout_marginStart="14dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="›" android:textSize="20sp" android:textColor="#C8BDB1"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- UYGULAMA HAKKINDA -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="UYGULAMA HAKKINDA" android:textSize="11sp"
                android:textColor="#B5A898" android:letterSpacing="0.15" android:layout_marginBottom="8dp"/>

            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="16dp"
                app:cardElevation="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingStart="16dp" android:paddingEnd="16dp">
                        <TextView android:layout_width="32dp" android:layout_height="32dp"
                            android:text="ℹ️" android:textSize="16sp" android:gravity="center"
                            android:background="@drawable/circle_orange_light"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="Versiyon"
                            android:textSize="13sp" android:textColor="#2C2318"
                            android:layout_marginStart="14dp"/>
                        <TextView android:id="@+id/tvVersion"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="1.0.0" android:textSize="13sp" android:textColor="#B5A898"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#E8E0D5" android:layout_marginStart="62dp"/>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingStart="16dp" android:paddingEnd="16dp">
                        <TextView android:layout_width="32dp" android:layout_height="32dp"
                            android:text="👩‍💻" android:textSize="16sp" android:gravity="center"
                            android:background="@drawable/circle_orange_light"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="Gelistirici"
                            android:textSize="13sp" android:textColor="#2C2318"
                            android:layout_marginStart="14dp"/>
                        <TextView android:id="@+id/tvDeveloper"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Busra Iriboy" android:textSize="13sp" android:textColor="#B5A898"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#E8E0D5" android:layout_marginStart="62dp"/>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:background="?attr/selectableItemBackground">
                        <TextView android:layout_width="32dp" android:layout_height="32dp"
                            android:text="📄" android:textSize="16sp" android:gravity="center"
                            android:background="@drawable/circle_orange_light"/>
                        <TextView android:id="@+id/btnTerms"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="Kullanim Kosullari"
                            android:textSize="13sp" android:textColor="#2C2318"
                            android:layout_marginStart="14dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="›" android:textSize="20sp" android:textColor="#C8BDB1"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#E8E0D5" android:layout_marginStart="62dp"/>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:background="?attr/selectableItemBackground">
                        <TextView android:layout_width="32dp" android:layout_height="32dp"
                            android:text="💬" android:textSize="16sp" android:gravity="center"
                            android:background="@drawable/circle_orange_light"/>
                        <TextView android:id="@+id/btnFeedback"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="Geri Bildirim Gonder"
                            android:textSize="13sp" android:textColor="#E8823A"
                            android:layout_marginStart="14dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="›" android:textSize="20sp" android:textColor="#C8BDB1"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        app:itemIconTint="#F5A623"
        app:itemTextColor="#F5A623"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>